{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "pedantic": "off"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-console": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "promise/no-return-wrap": "error",
    "unicorn/prefer-node-protocol": "error"
  },
  "overrides": [
    {
      "files": ["tools/*/web/**/*.{ts,tsx}"],
      "plugins": ["react", "jsx-a11y"],
      "env": { "browser": true },
      "rules": {
        // The automatic JSX runtime (`jsx: "react-jsx"`) makes an in-scope
        // `React` import unnecessary — and importing one purely to satisfy a
        // lint rule would be dead code.
        "react/react-in-jsx-scope": "off"
      }
    },
    {
      "files": ["**/test/**/*.{ts,tsx}", "**/*.test.{ts,tsx}"],
      "rules": {
        "no-console": "off",
        "typescript/no-explicit-any": "off",
        // Tests await in sequence on purpose — the ordering is usually the
        // thing under test. Parallelising them would change what they assert.
        "no-await-in-loop": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/", "node_modules/", "storage/", "*.tsbuildinfo"]
}
