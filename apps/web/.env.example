# Copy to `.env.local` to point the UI at a running `apps/api`.
#
# The default is the mock transport, so `npm run dev -w @downloader/web` needs
# no backend at all. Flip this to false once the API is running.
VITE_API_MOCK=false

# Empty means same-origin, which is what the Vite dev proxy in vite.config.ts
# provides. Set this only when the API is on a different host, in which case the
# API also needs CORS_ORIGINS set to this app's origin.
VITE_API_BASE_URL=

# Where the dev proxy forwards /api. Matches API_DEFAULTS in apps/api.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
