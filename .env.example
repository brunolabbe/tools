# Copy to .env and adjust. Parsed and validated once at boot — a bad value
# should fail startup, not surface halfway through a job.

# --- Server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Built UI to serve from this process, same-origin — which is also why there is
# no CORS to configure and why EventSource works without help. Unset serves
# nothing, which is a fine headless configuration. The container sets this.
# WEB_DIR=./apps/web/dist/app

# --- Storage ---
STORAGE_DIR=./storage
DATA_DIR=./data
# How long finished files stay downloadable before the GC removes them.
FILE_RETENTION_HOURS=6

# --- Concurrency ---
# ffmpeg is CPU and I/O hungry; 2 is a sane default on a laptop.
MAX_CONCURRENT_JOBS=2
# Each browser context costs roughly 300 MB.
MAX_CONCURRENT_BROWSERS=2
# Probe requests in flight at once, server-wide. Defaults to four per browser
# slot. Requests over this are refused immediately rather than queued.
# MAX_CONCURRENT_PROBES=8

# --- Limits ---
# Checked BEFORE downloading, estimated from bitrate x duration.
MAX_FILE_SIZE_MB=4096
# Everything under STORAGE_DIR, tmp/ included. 0 disables the quota. A download
# that would exceed it triggers a retention sweep first, and is refused with
# SIZE_LIMIT_EXCEEDED only if that did not free enough.
MAX_TOTAL_STORAGE_GB=50
# Browser sniffing is slow by nature — do not set this too low.
PROBE_TIMEOUT_MS=45000
JOB_TIMEOUT_MS=3600000

# --- External binaries ---
# Leave unset to use the bundled ffmpeg-static.
# FFMPEG_PATH=
# FFPROBE_PATH=
# Optional. The system degrades to browser-sniffing only when absent.
YTDLP_PATH=yt-dlp

# --- Resolvers ---
ENABLE_YTDLP_RESOLVER=true
ENABLE_BROWSER_RESOLVER=true

# --- Network ---
# Applies to probing AND downloading. Signed URLs are frequently IP-bound, so a
# mismatched egress between the two produces 403s that look like random flakes.
# Must be http:// or https:// — ProxyAgent speaks HTTP to the proxy, and a
# socks5:// value is refused at boot rather than at the first request.
# Setting this also turns OFF connection address-pinning, because the target is
# resolved by the proxy rather than here; the proxy's own egress policy is what
# bounds the service then. See docs/04-STATUS.md.
# PROXY_URL=

# --- Rate limiting ---
# Per client, as a token bucket: the value is both the sustained rate and the
# burst a rested client may spend at once. 0 disables that bucket.
RATE_LIMIT_PROBE_PER_MINUTE=10
RATE_LIMIT_JOBS_PER_MINUTE=5

# Whether X-Forwarded-For may name the client. OFF by default and deliberately
# so: every limit above is keyed on the client address, and trusting a header
# anyone can send makes them decorative. Set to `true`, or better to the proxy's
# address or CIDR, only when something in front of this overwrites the header.
# TRUST_PROXY=false
