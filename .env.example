# Copy to .env and adjust. Parsed and validated once at boot — a bad value
# should fail startup, not surface halfway through a job.

# --- Server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Built UI to serve from this process, same-origin — which is also why there is
# no CORS to configure and why EventSource works without help. Unset serves
# nothing, which is a fine headless configuration. The container sets this.
# WEB_DIR=./apps/web/dist/app

# --- Storage ---
STORAGE_DIR=./storage
DATA_DIR=./data
# How long finished files stay downloadable before the GC removes them.
FILE_RETENTION_HOURS=6

# --- Concurrency ---
# ffmpeg is CPU and I/O hungry; 2 is a sane default on a laptop.
MAX_CONCURRENT_JOBS=2
# Each browser context costs roughly 300 MB.
MAX_CONCURRENT_BROWSERS=2
# Probe requests in flight at once, server-wide. Defaults to four per browser
# slot. Requests over this are refused immediately rather than queued.
# MAX_CONCURRENT_PROBES=8

# --- Limits ---
# Checked BEFORE downloading, estimated from bitrate x duration.
MAX_FILE_SIZE_MB=4096
# Everything under STORAGE_DIR, tmp/ included. 0 disables the quota. A download
# that would exceed it triggers a retention sweep first, and is refused with
# SIZE_LIMIT_EXCEEDED only if that did not free enough.
MAX_TOTAL_STORAGE_GB=50
# Browser sniffing is slow by nature — do not set this too low.
PROBE_TIMEOUT_MS=45000
JOB_TIMEOUT_MS=3600000

# --- External binaries ---
# Leave unset to use the bundled ffmpeg-static.
# FFMPEG_PATH=
# FFPROBE_PATH=
# Optional. The system degrades to browser-sniffing only when absent.
YTDLP_PATH=yt-dlp

# --- Resolvers ---
ENABLE_YTDLP_RESOLVER=true
ENABLE_BROWSER_RESOLVER=true

# --- Network ---
# Applies to probing AND downloading. Signed URLs are frequently IP-bound, so a
# mismatched egress between the two produces 403s that look like random flakes.
# Must be http:// or https:// — ProxyAgent speaks HTTP to the proxy, and a
# socks5:// value is refused at boot rather than at the first request.
# Setting this also turns OFF connection address-pinning, because the target is
# resolved by the proxy rather than here; the proxy's own egress policy is what
# bounds the service then. Pinning is not weakened by the proxy — it is simply
# not the mechanism in play, and the pre-flight SSRF check still runs either way.
# The reasoning, and the tests, are in
# tools/downloader/docs/work/dl-8-address-pinning-and-proxy.md.
# PROXY_URL=

# ffmpeg checks the certificate of the manifest it fetches. It did not before
# dl-19 — libavformat's `tls_verify` defaults to off — so a site whose chain is
# broken, expired, or served without its intermediates downloaded fine until now
# and stops here. That is the point: encrypted to nobody in particular is not the
# same as authenticated.
#
# Segment fetches are covered too since dl-27, and not by ffmpeg: libavformat
# does not pass the TLS options down to the connections the HLS and DASH
# demuxers open, and no ffmpeg option changes that — dl-21 measured sixteen of
# them on two builds and read the list out of the shipped binary. The one option
# that IS propagated is http_proxy, so ffmpeg's egress proxy terminates its TLS
# and verifies every origin itself. That is what the next setting turns off.
#
# FFMPEG_TLS_INTERCEPT=false puts ffmpeg back behind a tunnelling proxy: the
# manifest stays verified and the segments go back to unverified, which is
# dl-21's hole reopened deliberately. It exists so an operator whom the
# interception breaks has somewhere to go that is NOT the last-resort setting at
# the bottom of this block, which gives up the manifest as well. The API warns at
# boot in either state. An unparseable value leaves interception ON.
# FFMPEG_TLS_INTERCEPT=true
#
# If your origins chain to a private root — a TLS-inspecting middlebox, an
# internal CDN — point this at that root's PEM. It is the right answer for that
# case, and the setting below is not.
#
# It is MERGED with the public roots rather than replacing them, so setting it
# does not stop public origins from being trusted. Everything in this service
# that meets an origin is given it: the egress proxy that verifies on ffmpeg's
# behalf, the undici dispatcher behind every probe and direct fetch, and ffmpeg
# itself when FFMPEG_TLS_INTERCEPT is off. A path this process cannot read is
# refused at boot rather than one download at a time.
#
# Named FFMPEG_CA_FILE until dl-31. That spelling still works and still means
# this, and the API warns once at boot naming it; EGRESS_CA_FILE wins if both
# are set. The rename is because the file stopped being about ffmpeg — dl-27
# handed it to a proxy that is not ffmpeg, and dl-31 to a dispatcher that is
# not either.
# EGRESS_CA_FILE=/usr/local/share/ca-certificates/corp-root.crt
#
# The last resort: turn verification off entirely. Everything on the path to a
# CDN can then substitute the video and this service will remux it without
# complaint, so the API logs a warning naming this variable on every boot while
# it is set. Never set it to make a test or a fixture pass — pass the fixture's
# CA above instead.
# FFMPEG_ALLOW_UNVERIFIED_TLS=false

# --- Rate limiting ---
# Per client, as a token bucket: the value is both the sustained rate and the
# burst a rested client may spend at once. 0 disables that bucket.
RATE_LIMIT_PROBE_PER_MINUTE=10
RATE_LIMIT_JOBS_PER_MINUTE=5

# Whether X-Forwarded-For may name the client. OFF by default and deliberately
# so: every limit above is keyed on the client address, and trusting a header
# anyone can send makes them decorative. Set to `true`, or better to the proxy's
# address or CIDR, only when something in front of this overwrites the header.
# TRUST_PROXY=false
