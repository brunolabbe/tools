{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "claudeMdExcludes": ["**/.claude/worktrees/**"],
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh api *)",
      "Bash(gh auth token*)",
      "Bash(npm publish*)",
      "Bash(git push * main*)",
      "Bash(git push *:main*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)"
    ],
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run status)",
      "Bash(npm run status -- *)",
      "Bash(npm test)",
      "Bash(npm test -- *)",
      "Bash(npm run test:*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npx vitest run *)",
      "Bash(npx oxlint *)",
      "Bash(npx oxfmt *)",
      "Bash(npx tsc *)",
      "Bash(node scripts/status.mjs *)",
      "Bash(node scripts/commit-message.mjs *)",
      "Bash(bash .claude/scripts/worktree-farm.sh*)",
      "Bash(git worktree list)",
      "Bash(git worktree prune)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-markdown.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-pr-title.sh"
          }
        ]
      }
    ]
  }
}
