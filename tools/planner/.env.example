# The planner API's settings, each shown with its default. Parsed once at boot
# in api/src/config.ts, the only place this tool reads the environment.
#
# **Nothing loads this file, or a .env made from it.** Neither
# `npm run dev:planner` nor the API reads one, so set what you change in the
# shell:
#
#   GROUNDING_PROVIDER=valhalla VALHALLA_URL=http://localhost:8002 npm run dev:planner:api
#
# The container sets its own in compose.planner.prod.yaml. A deployment host's
# `.env` is a different file with a different job: see .env.prod.example at the
# repository root.

# --- Server ---
# Not 8080, which is the downloader's, so both tools run at once unconfigured.
PORT=8090
HOST=127.0.0.1
LOG_LEVEL=info

# Built UI to serve from this process, same-origin. Unset serves nothing, which
# is a fine headless configuration. The container sets this. A relative path is
# resolved from the directory the API starts in, which for
# `npm run dev:planner:api` is tools/planner/api.
# WEB_DIR=../web/dist/app

# Origins allowed to call the API from a browser, comma-separated. Empty means
# same-origin only.
# CORS_ORIGINS=

# --- Storage ---
# The SQLite file. Defaults to ./storage/planner/planner.db, resolved from the
# directory the API starts in; `:memory:` keeps it in the process, which is what
# the tests use.
# DATABASE_PATH=./storage/planner/planner.db

# --- Model ---
# `scripted` answers from a fixed script: a fresh clone runs with no key, no
# account and no bill, and it is what CI uses. It is the only provider this
# build knows; an unrecognised value falls back to it.
MODEL_PROVIDER=scripted
# Ceiling on one model reply, in tokens. At most 32000.
MAX_OUTPUT_TOKENS=2048

# --- Grounding: distances, places, what is nearby ---
# `fixtures` answers from a checked-in table and reaches nothing. `valhalla`
# measures for real and refuses to boot without VALHALLA_URL and GEOCODER_URL.
# An unrecognised value falls back to `fixtures`, and the plan says which legs
# went unmeasured.
GROUNDING_PROVIDER=fixtures
# No defaults, on purpose: a fallback to somebody's public instance is a
# surprise bill or a surprise outage. A router does not geocode, hence two.
# VALHALLA_URL=
# GEOCODER_URL=
# Optional even under `valhalla`: unset, a run simply discovers nothing nearby.
# Point it at a self-hosted instance; the public one is too slow for a long
# corridor (149 s measured, pl-33).
# OVERPASS_URL=

# Per-request ceilings, in milliseconds. Short on purpose: a run holds a queue
# slot while it grounds. Discovery is a different backend and gets its own.
GROUNDING_TIMEOUT_MS=5000
GROUNDING_DISCOVERY_TIMEOUT_MS=30000
# Grounding calls one run may make. A matrix over many places is one call. 0
# allows none.
MAX_GROUNDING_CALLS=40
# How long a grounded answer stays good, in hours, per kind: a place for a year,
# a road for six months. Applied when an answer is stored, so a change here does
# not touch what is already cached.
GROUNDING_CACHE_TTL_LOCATE_HOURS=8760
GROUNDING_CACHE_TTL_TRAVEL_HOURS=4320

# --- Spend and load ---
# Specialists one run may pay for. At 5, some trip shapes drop the budget
# specialist and the plan says so; that is the cap working, not a bug.
MAX_SPECIALISTS=5
# Hard ceiling on one run's output tokens, spent by running fewer specialists
# rather than stopping partway. Unset means no ceiling beyond MAX_SPECIALISTS.
# RUN_TOKEN_BUDGET=
# Each run is itself a fan-out, so this bounds memory and spend.
MAX_CONCURRENT_RUNS=2
# Runs one client may start per minute. A run is a roster of model calls, cheap
# to request and costly to serve. 0 disables it.
RATE_LIMIT_RUNS_PER_MINUTE=5

# Whether X-Forwarded-For may name the client. OFF by default and deliberately
# so: the limit above is keyed on the client address, and trusting a header any
# client can send makes it decorative. Set to `true`, or better to the proxy's
# address or CIDR, only when something in front of this overwrites the header.
# TRUST_PROXY=false
