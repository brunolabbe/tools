      <SegmentTemplate timescale="1000" duration="4000" initialization="$RepresentationID$/init.mp4" media="$RepresentationID$/segment-$Number$.m4s" startNumber="1"/>
      <Representation id="video-avc1-1" bandwidth="401000" codecs="avc1.4D401E" width="640" height="360" frameRate="24" sar="1:1"/>
      <Representation id="video-avc1-2" bandwidth="751000" codecs="avc1.4D401F" width="1280" height="720" frameRate="24" sar="1:1"/>
      <Representation id="video-avc1-3" bandwidth="2100000" codecs="avc1.640028" width="1920" height="1080" frameRate="24" sar="1:1"/>
      <Representation id="video-avc1-4" bandwidth="4200000" codecs="avc1.640028" width="1920" height="1080" frameRate="24" sar="1:1"/>
    </AdaptationSet>
    <AdaptationSet
      id="2"
      group="2"
      contentType="audio"
      lang="en"
      mimeType="audio/mp4"
      segmentAlignment="true"
      startWithSAP="1">
