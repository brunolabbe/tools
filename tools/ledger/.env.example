# The ledger API's settings, each shown with its default. Parsed once at boot
# in api/src/config.ts, the only place this tool reads the environment.
#
# Copy it to tools/ledger/.env (gitignored) and `npm run dev:ledger` loads it —
# that script only: the API itself, `start`, the e2e servers and the image never
# read one. A variable set in the shell wins over the file, so a one-off still
# works:
#
#   LOG_LEVEL=debug npm run dev:ledger:api
#
# The container sets its own in compose.ledger.prod.yaml. A deployment host's
# `.env` is a different file with a different job: see .env.prod.example at the
# repository root.

# --- Server ---
# Not 8080 or 8090, which are the downloader's and the planner's, so every tool
# runs at once unconfigured.
PORT=8100
HOST=127.0.0.1
LOG_LEVEL=info

# Whether X-Forwarded-For may name the client. Off by default; behind the
# tunnel, set it to the proxy's CIDR and never to `true`.
# TRUST_PROXY=

# Requests a person may make per minute, to the routes that read and to the
# routes that write. Per person (the Access identity), not per address. Every API
# route but /api/health is limited; zero turns one limiter off.
# RATE_LIMIT_READS_PER_MINUTE=120
# RATE_LIMIT_WRITES_PER_MINUTE=60

# Built UI to serve from this process, same-origin. Unset serves nothing, which
# is a fine headless configuration. The container sets this. A relative path is
# resolved from the directory the API starts in, which for
# `npm run dev:ledger:api` is tools/ledger/api.
# WEB_DIR=../web/dist/app

# Origins allowed to call the API from a browser, comma-separated. Empty means
# same-origin only.
# CORS_ORIGINS=

# --- Storage ---
# The SQLite file. Defaults to ./storage/ledger/ledger.db, resolved from the
# directory the API starts in; `:memory:` keeps it in the process, which is what
# the tests use. It will hold real bank history: keep it out of the checkout's
# tracked files — `storage/` is gitignored — and back it up.
# DATABASE_PATH=./storage/ledger/ledger.db

# --- Identity (lg-3) ---
# Cloudflare Access: every API route but /api/health needs a token Access signed
# for this team and this application, for an address ACCESS_PEOPLE maps to a
# person. Unset, every API route but health is refused. The production overlay
# sets all three from the host's .env (LEDGER_ACCESS_*).
# ACCESS_TEAM=            # the <team> in <team>.cloudflareaccess.com
# ACCESS_AUD=             # the Access application's AUD tag
# ACCESS_PEOPLE=          # address=person pairs, comma-separated

# Development only: every request is this address (it must be in
# ACCESS_PEOPLE), and no token is read. The API refuses to start with it when
# NODE_ENV=production, which the image sets.
#   ACCESS_PEOPLE=alex@example.test=alex DEV_IDENTITY=alex@example.test npm run dev:ledger:api
# DEV_IDENTITY=
