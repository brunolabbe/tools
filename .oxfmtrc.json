{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".claude/",
    "dist/",
    "node_modules/",
    "storage/",
    "coverage/",
    // The `**/` is load-bearing: an entry with an internal slash is anchored to
    // this directory, so a bare `test/fixtures/` matches nothing. See CLAUDE.md.
    "**/test/fixtures/",
    "**/CHANGELOG.md"
  ]
}
