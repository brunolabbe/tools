{
  // Brought in rather than left out. `commit-message.mjs` is plain JS and stays
  // that way — the commit hook runs it under bare node with no build step — but
  // the test that exercises it is TypeScript, and what it asserts is the
  // `{ ok, errors }` shape the hook and the CI gate both read. `allowJs` lets
  // tsc infer `validate`'s signature from the source so those calls are checked;
  // `checkJs` stays off, because the `.mjs` is not this project's to hold to
  // `strict`. `allowJs` is per-project, which is the whole reason this is one.
  //
  // Both `.mjs` files are named in `include` because a composite project must
  // list every file in its program, and they live one level up from the tests.
  // `status.mjs` is here for the same reason and on the same terms: its
  // `{ id, status, milestone, … }` shape is what the tests assert, and
  // `allowJs` is what lets tsc infer it from the source. `citations.mjs`
  // joins them on identical terms — a new script here costs one entry in
  // this list, and forgetting it fails loudly as TS6307 rather than quietly.
  "extends": "../../tsconfig.tests.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false
  },
  "include": ["**/*.ts", "../commit-message.mjs", "../status.mjs", "../citations.mjs"],
  // Restated, not inherited — the root's exclude is about the root's program.
  "exclude": []
}
