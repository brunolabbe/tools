# The build stage runs `npm ci` itself, and a host `node_modules` would both
# bloat the context and — worse — carry native builds and Playwright browsers
# compiled for the host platform into a Linux image.
node_modules
**/node_modules

# Rebuilt inside the image. Copying a host build in risks a stale `dist` and a
# `.tsbuildinfo` that convinces `tsc --build` there is nothing to do.
dist
**/dist
**/*.tsbuildinfo

# Runtime artifacts, and the one directory that could be tens of gigabytes.
# `**/` as well: a dev API run from its workspace writes `<tool>/api/storage/`,
# and for the ledger that is real bank history.
storage
**/storage
downloads
tmp
data
*.log
logs
*.sqlite*

# Secrets must never enter the build context: every layer is readable by
# anyone who can pull the image. `**/` as well: each tool keeps its own
# `tools/<tool>/.env` for its dev script, and every build stage copies its whole
# tool directory.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

.git
.github
.claude
playwright-report
test-results
**/e2e/.artifacts

docs
*.md
!README.md

.vscode
.idea
.DS_Store
Thumbs.db
