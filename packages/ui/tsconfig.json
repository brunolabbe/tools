{
  "extends": "../../tsconfig.base.json",
  // The web surface (Bundler + DOM + JSX), the same as each tool's `web`: this
  // package's source is compiled by the tool's Vite, never by tsc, which only
  // checks it and emits the declarations a tool's `tsc --build` reads through
  // its project reference (repo-131).
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
